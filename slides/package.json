{
  "name": "slides",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --dir ext/slidev-theme-spc-gt install && slidev build",
    "build:teaser": "pnpm --dir ext/slidev-theme-spc-gt install && slidev build slides_teaser.md",
    "build:archive": "pnpm --dir ext/slidev-theme-spc-gt install && slidev build slides_archive.md",
    "dev": "pnpm --dir ext/slidev-theme-spc-gt install && slidev --open",
    "dev:teaser": "pnpm --dir ext/slidev-theme-spc-gt install && slidev slides_teaser.md --open --port 3033",
    "dev:archive": "pnpm --dir ext/slidev-theme-spc-gt install && slidev slides_archive.md --open --port 3044",
    "export": "slidev export",
    "export:archive": "slidev export slides_archive.md",
    "postinstall": "cd ext/slidev-theme-spc-gt && pnpm install"
  },
  "dependencies": {
    "@slidev/cli": "^52.20.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-addon-fancy-arrow": "^0.20.2",
    "slidev-addon-tikzjax": "^0.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "playwright-chromium": "^1.64.1"
  }
}
